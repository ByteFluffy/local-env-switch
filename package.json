{
  "name": "local-env-switch",
  "version": "0.1.0",
  "private": false,
  "description": "Generic Infisical-backed local .env switcher (CLI + programmatic API)",
  "author": "ByteFluffy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ByteFluffy/local-env-switch.git"
  },
  "homepage": "https://github.com/ByteFluffy/local-env-switch#readme",
  "bugs": {
    "url": "https://github.com/ByteFluffy/local-env-switch/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "local-env-switch": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples",
    "AGENT_INTEGRATION_PROMPT.md",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "cli": "node --import tsx src/cli.ts",
    "prepack": "npm run build",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^25.7.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "infisical",
    "dotenv",
    "local-env",
    "secrets"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
